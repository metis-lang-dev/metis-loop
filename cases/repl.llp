% CI case for the repl domain (console-nav s-b923ebfe; packages.py's convention): the program
% included unchanged, with a start that fires. Not a domain: the program's own #init is its
% live start (served by the domain agent) and stays as it is; this case is metisc --run's and
% metispy's (tests/test_console_domains.py).
catalog repl_case 1.
include "../domains/repl/repl.llp".
% "run" with nothing loaded is refused with its reason
#init idle 1
#init unloaded 1
#init chat_seat 1
#init cmd_run 1
#steps 2
#seeds 1
#query refused(run)
#query unloaded
