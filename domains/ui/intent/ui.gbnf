char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
intent ::= "\"GO\"" | "\"EXIT\"" | "\"HOME\"" | "\"BACK\"" | "\"PICK\"" | "\"NUMBERS\"" | "\"SHOW\"" | "\"CLOSE\"" | "\"CANCEL\"" | "\"MODE\"" | "\"HELP\"" | "\"UNKNOWN\""
intent-kv ::= "\"intent\"" space ":" space intent
name-kv ::= "\"name\"" space ":" space string
name-rest ::= ( "," space number-kv )? number-rest
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
number-kv ::= "\"number\"" space ":" space number
number-rest ::= ( "," space to-kv )?
root ::= "{" space intent-kv ( "," space ( widget-kv widget-rest | name-kv name-rest | number-kv number-rest | to-kv ) )? "}" space
space ::= " "?
string ::= "\"" char* "\"" space
to ::= "\"DICTATION\"" | "\"COMMAND\""
to-kv ::= "\"to\"" space ":" space to
widget ::= "\"BAND\"" | "\"SESSBAR\"" | "\"CATIN\"" | "\"DEBUGGER\"" | "\"STREAM\"" | "\"LENSES\"" | "\"CHIPS\"" | "\"PROMPT\"" | "\"CHAT\"" | "\"CHATLOG\"" | "\"CHATQ\"" | "\"CATALOG\"" | "\"COPY\"" | "\"EXTENSIONS\"" | "\"README\"" | "\"CANDIDATES\"" | "\"RECORDS\"" | "\"EDITOR\"" | "\"APPLY\""
widget-kv ::= "\"widget\"" space ":" space widget
widget-rest ::= ( "," space name-kv )? name-rest