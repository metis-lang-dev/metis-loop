char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
intent ::= "\"LOAD\"" | "\"RUN\"" | "\"STEP\"" | "\"UNDO\"" | "\"RESET\"" | "\"NARRATE\"" | "\"RECORDS\"" | "\"APPLY\"" | "\"STOP\"" | "\"TELL\"" | "\"HELP\"" | "\"UNKNOWN\""
intent-kv ::= "\"intent\"" space ":" space intent
n-kv ::= "\"n\"" space ":" space number
n-rest ::= ( "," space text-kv )?
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
package-kv ::= "\"package\"" space ":" space string
package-rest ::= ( "," space n-kv )? n-rest
root ::= "{" space intent-kv ( "," space ( package-kv package-rest | n-kv n-rest | text-kv ) )? "}" space
space ::= " "?
string ::= "\"" char* "\"" space
text-kv ::= "\"text\"" space ":" space string